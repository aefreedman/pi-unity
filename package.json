{
  "name": "@aefree/pi-unity",
  "version": "0.17.0",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run typecheck",
    "test": "tsx tests/pi-host-compatibility.test.ts && tsx tests/unity-projects.test.ts && tsx tests/unity-artifact-profile.test.ts && tsx tests/unity-file-discovery-filter.test.ts && tsx tests/unity-optional-integrations.test.ts && tsx tests/release-registry-preflight.test.ts && tsx tests/unity-package-validation.test.ts"
  },
  "peerDependencies": {
    "@aefree/pi-file-discovery": "^0.1.0",
    "@aefree/pi-project-artifacts": "^0.1.0",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Native Unity CLI and Pipeline guidance, Unity project discovery, and optional Pi integrations.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aefreedman/pi-unity.git"
  },
  "bugs": {
    "url": "https://github.com/aefreedman/pi-unity/issues"
  },
  "homepage": "https://github.com/aefreedman/pi-unity#readme",
  "devDependencies": {
    "@aefree/pi-file-discovery": "^0.1.0",
    "@aefree/pi-project-artifacts": "^0.1.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typebox": "1.3.8",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@aefree/pi-project-artifacts": {
      "optional": true
    },
    "@aefree/pi-file-discovery": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
